    "Deaktivierte Listen werden ausgeblendet. Halte und ziehe um die Reihenfolge zu ändern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivierte Listen werden ausgeblendet. Halte und ziehe um die Reihenfolge zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabled lists are hidden. Hold and drag to change the order."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les listes désactivées sont masquées. Maintiens et fais glisser pour modifier l’ordre."
          }
        }
      }
    },
    "Dein HörspielLog ist bereit" : {
      "localizations" : {
        "de" : {
