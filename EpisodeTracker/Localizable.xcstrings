    "Nur fuer Entwicklung und Tests: Cloud-Sync wird erst nach dem naechsten App-Start aktiv, wenn Anforderung und Schutzschalter gleichzeitig gesetzt sind." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur fuer Entwicklung und Tests: Cloud-Sync wird erst nach dem naechsten App-Start aktiv, wenn Anforderung und Schutzschalter gleichzeitig gesetzt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For development and testing only: Cloud sync becomes active after the next app launch when both the request and safety switch are enabled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le développement et les tests uniquement : la synchronisation iCloud ne devient active qu’au prochain démarrage de l’app, lorsque la demande et le commutateur de sécurité sont activés en même temps."
          }
        }
      }
    },
    "Nur Kataloge mit offiziell angekündigtem Termin. Für andere aktivierte Kataloge liegt kein verlässliches Datum vor." : {
      "comment" : "A footnote explaining that the upcoming releases are based on the official release dates.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Kataloge mit offiziell angekündigtem Termin. Für andere aktivierte Kataloge liegt kein verlässliches Datum vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only catalogs with an officially announced date. No reliable date is available for your other enabled catalogs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement les catalogues avec une date officiellement annoncée. Aucune date fiable n’est disponible pour tes autres catalogues activés."
          }
        }
      }
    },
